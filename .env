# =====================================
# APP CONFIGURATION
# =====================================
APP_NAME=ms-monitoring-qa-be
APP_HOST=127.0.0.1
APP_PORT=3002
APP_VERSION=1.0.0
APP_ERROR_JSON_PATH=./errorContract.json
APP_ENV_PREFIX=MS_MONITORING_QA_BE
APP_ENV=development
APP_SERVER_URL=http://127.0.0.1:3002

# =====================================
# DB CONFIGURATION
# =====================================
DB_NAME=ms-monitoring-qa-be-local
DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASS=secret
DB_MAX_IDLE_CONNECTION=10
DB_MAX_OPEN_CONNECTION=100
DB_MAX_CONN_LIFE_TIME=30s

# =====================================
# CACHE (REDIS) CONFIGURATION
# =====================================
CACHE_ADDRESS=127.0.0.1:6379
CACHE_USER_NAME=
CACHE_PASSWORD=
CACHE_DB=0
CACHE_USING_TLS=false
CACHE_TLS_CA_CERT=
CACHE_TLS_CERT=
CACHE_TLS_KEY=
CACHE_POOL_SIZE=10
CACHE_MIN_IDLE_CONN=10
CACHE_DIAL_TIMEOUT=1m
CACHE_READ_TIMEOUT=1m
CACHE_WRITE_TIMEOUT=1m
CACHE_MAX_CONN_AGE=1h

# =====================================
# OTEL CONFIGURATION
# =====================================
OTEL_COLLECTORADDR=localhost:4317
